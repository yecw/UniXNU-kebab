# Kernel configuration for the OnePlus 8T (SM8250 / kebab).
# Minimal DT-platform kernel. Device drivers that the UniXNU patches reference
# are satisfied by scripts/kebab_stubs.c (weak no-op definitions).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
# Original-PMGR bridge (package/ShengPlatformPower.cpp, scripts/build-platform-power.py):
# the working SM8250 ports panic in AMFI with "No PMGR" without it.
CONFIG_XNU_SHENG_PMGR=y
# Panic log region from the ADT (/pram + /chosen/embedded-panic-log-size); the
# payload's panic screen then has somewhere to report to.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/kebab-stubs/libKebabStubs.a"

# kebab_ufs.c is linked from the device XNU patches. Do not enable the
# ShengUfs (SM8550 NativeUfs) archive; build-xnu-4k-baseline.sh would then
# require build/sheng-ufs/libShengUfs.a, which this board does not build.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
# Boot progress: the kernel log goes to the stock ramoops zone (0xB0000000)
# through kits/kebab/BootRamoops.c and scripts/build-boot-progress.py.
CONFIG_XNU_BOOT_PROGRESS=y
# This board's diagnostics need neither the UFS nor the owner-root paths.
CONFIG_XNU_BOOT_PROGRESS_ANY=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_CACHE_CARRIER=y
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="9CBCD367-CFD7-4EE8-B271-0AB8436F6BCA"
