@@ -113,8 +113,12 @@ AdvanceNewLine (
 
   // Verify Y Position
   if (CurrentPosition->YPos >= MaxPosition.YPos) {
-    // Clear Frame Buffer
-    ZeroMem ((VOID *)FbBase, FB_WIDTH * FB_HEIGHT * FB_BPP);
+    //
+    // KEBAB: clear instead of scrolling. Scrolling keeps the last screen of log
+    // (which once saved a lost DxeCore report) but copies the whole 10 MiB
+    // framebuffer per line, which made the DEBUG boot crawl on this panel.
+    //
+    ZeroMem ((VOID *)(UINTN)FbBase, FB_WIDTH * FB_HEIGHT * FB_BPP);
 
     // Reset X & Y Position
     CurrentPosition->XPos = 0;
@@ -183,6 +187,12 @@ WriteFrameBuffer (
       AdvanceNewLine (FbBase, FbLength, CurrentPosition, MaxPosition);
     } else if (Character == '\r') {
       CurrentPosition->XPos = 0;
+    } else if (Character == '\f') {
+      // Form feed clears the screen and homes the cursor. DarwinBoot uses it to
+      // put its hand-off log at the top of the panel.
+      ZeroMem ((VOID *)FbBase, FB_WIDTH * FB_HEIGHT * FB_BPP);
+      CurrentPosition->XPos = 0;
+      CurrentPosition->YPos = 0;
     }
 
     return;
@@ -250,6 +260,7 @@ SerialPortWrite (
 
   // Get Frame Buffer Memory
   Status = GetFrameBufferMemory (&FbBase, &FbLength);
+
   if (EFI_ERROR (Status)) {
     return 0;
   }
@@ -262,6 +273,15 @@ SerialPortWrite (
     ArmDisableInterrupts ();
   }
 
+  // Capture the first console row before writing, so the cache maintenance
+  // below can flush only the rows this chunk touched.
+  EFI_FRAME_BUFFER_POSITION *FlushPos;
+  EFI_FRAME_BUFFER_POSITION  FlushMax;
+  UINT8                      FlushScale = GetFontScale ();
+  UINTN                      FlushStartY;
+  GetFbPositions (FbBase, FbLength, FlushScale, &FlushPos, &FlushMax);
+  FlushStartY = FlushPos->YPos;
+
   // Write Debug Message to Frame Buffer
   for (UINTN i = 0; i < NumberOfBytes; i++) {
     WriteFrameBuffer (FbBase, FbLength, *Buffer++);
@@ -272,8 +292,25 @@ SerialPortWrite (
     ArmEnableInterrupts ();
   }
 
-  // Flush Frame Buffer
-  WriteBackInvalidateDataCacheRange ((VOID *)FbBase, FbLength);
+  // Flush only the rows this write touched. Flushing the whole framebuffer
+  // (1080*2400*4 = ~10.4 MiB) for every log chunk is what made the DXE log
+  // crawl on this panel; a clear or a scroll still gets one full flush.
+  {
+    UINTN GlyphHeight = (FONT_HEIGHT - 4) * FlushScale;
+    UINTN RowBytes = FB_WIDTH * FB_BPP;
+    UINTN EndY;
+    GetFbPositions (FbBase, FbLength, FlushScale, &FlushPos, &FlushMax);
+    EndY = FlushPos->YPos;
+    if ((EndY < FlushStartY) || (FlushStartY >= FB_HEIGHT) || (EndY >= FB_HEIGHT)) {
+      WriteBackInvalidateDataCacheRange ((VOID *)FbBase, FbLength);
+    } else {
+      UINTN First = FlushStartY * GlyphHeight * RowBytes;
+      UINTN Last  = (EndY + 1) * GlyphHeight * RowBytes;
+      if (Last > FbLength) { Last = FbLength; }
+      if (Last > First) { WriteBackInvalidateDataCacheRange ((VOID *)(UINTN)(FbBase + First), Last - First); }
+    }
+    WriteBackInvalidateDataCacheRange ((VOID *)FlushPos, sizeof (*FlushPos));
+  }
 
   return NumberOfBytes;
 }
