diff --git a/bsd/dev/kebab_ufs.c b/bsd/dev/kebab_ufs.c
index 9f80000..51d1e60 100644
--- a/bsd/dev/kebab_ufs.c
+++ b/bsd/dev/kebab_ufs.c
@@ -30,6 +30,7 @@
 #include <sys/errno.h>
 #include <sys/fcntl.h>
 #include <sys/proc.h>
+#include <sys/proc_internal.h>
 #include <sys/uio.h>
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
@@ -638,6 +639,23 @@ kebab_ufs_strategy(buf_t bp)
 					kebab_early_mark(253, "ufs: bsd reads");
 					kebab_early_hex(kebab_bsd_reads);
 				}
+#if defined(KEBAB)
+				/* KEBAB bring-up: name the first PID 1 reads so "no
+				 * userland I/O" cannot hide behind the 64-read window. */
+				{
+					extern void kebab_early_mark(unsigned, const char *);
+					extern void kebab_early_hex(unsigned long long);
+					static uint64_t kebab_pid1_reads;
+					struct proc *kebab_proc = current_proc();
+					if (kebab_pid1_reads < 8 && kebab_proc != NULL &&
+					    proc_getpid(kebab_proc) == 1) {
+						kebab_pid1_reads++;
+						kebab_early_mark(259, "ufs: pid1 read");
+						kebab_early_hex(lba);
+						kebab_early_hex(blocks);
+					}
+				}
+#endif
 			}
 		} else {
 			/* Partial device blocks at either end: read, merge, write back. */
@@ -1165,6 +1183,27 @@ kebab_ufs_raw_io(void *buffer, uint64_t offset, size_t length, bool write)
 			error = ufs_read_blocks(lba, blocks);
 			if (!error) {
 				memcpy(bytes + done, (const char *)bounce + skip, want);
+#if defined(KEBAB)
+				{
+					extern void kebab_early_mark(unsigned, const char *);
+					extern void kebab_early_hex(unsigned long long);
+					static uint64_t kebab_raw_reads, kebab_raw_pid1;
+					struct proc *kebab_proc;
+					kebab_raw_reads++;
+					if (kebab_raw_reads == 1 || (kebab_raw_reads % 2048) == 0) {
+						kebab_early_mark(276, "ufs: os window reads");
+						kebab_early_hex(kebab_raw_reads);
+					}
+					kebab_proc = current_proc();
+					if (kebab_raw_pid1 < 8 && kebab_proc != NULL &&
+					    proc_getpid(kebab_proc) == 1) {
+						kebab_raw_pid1++;
+						kebab_early_mark(274, "ufs: pid1 os read");
+						kebab_early_hex(offset + done);
+						kebab_early_hex(lba);
+					}
+				}
+#endif
 			}
 		}
 		done += want;
@@ -1211,6 +1250,26 @@ kebab_ufs_systemos_read(void *buffer, uint64_t offset, size_t length)
 		error = ufs_read_blocks(lba, blocks);
 		if (!error) {
 			memcpy(bytes + done, (const char *)bounce + skip, want);
+#if defined(KEBAB)
+			{
+				extern void kebab_early_mark(unsigned, const char *);
+				extern void kebab_early_hex(unsigned long long);
+				static uint64_t kebab_sysos_reads;
+				struct proc *kebab_proc;
+				kebab_sysos_reads++;
+				if (kebab_sysos_reads == 1 || (kebab_sysos_reads % 2048) == 0) {
+					kebab_early_mark(275, "ufs: sysos reads");
+					kebab_early_hex(kebab_sysos_reads);
+					kebab_early_hex(offset + done);
+				}
+				kebab_proc = current_proc();
+				if (kebab_sysos_reads <= 4 && kebab_proc != NULL &&
+				    proc_getpid(kebab_proc) == 1) {
+					kebab_early_mark(277, "ufs: pid1 sysos read");
+					kebab_early_hex(offset + done);
+				}
+			}
+#endif
 		}
 		done += want;
 	}
diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
