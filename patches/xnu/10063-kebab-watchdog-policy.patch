--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8088,7 +8088,107 @@
 	vnode_put(vp);
 }
 
+/*
+ * KEBAB: the original watchdogd cannot check in on this kernel (no Apple
+ * watchdog device), so disable only its launch job for this boot by writing
+ * launchd's own root-owned policy before the init exec. Same mechanism as the
+ * reference ports (picasso's picasso_boot_watchdog_policy); the watchdog
+ * implementation itself is neither replaced nor bypassed.
+ */
 static int
+kebab_boot_watchdog_policy(proc_t p, user_addr_t scratch)
+{
+	static const char directory[] = "/private/var/db/com.apple.xpc.launchd";
+	static const char path[] = "/private/var/db/com.apple.xpc.launchd/disabled.plist";
+	static const char marker[] = "/private/var/db/com.apple.xpc.launchd/disabled.migrated";
+	static const char policy[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\"><dict>"
+	    "<key>com.apple.watchdogd</key><true/>"
+	    "</dict></plist>\n";
+	int enabled = 0;
+	int32_t result = 0;
+	int error = 0;
+	int fd = -1;
+	struct mkdir_args md = {};
+	struct open_args op = {};
+	struct write_args wr = {};
+	struct close_args close_args = {};
+
+	if (!PE_parse_boot_argn("kebab-disable-watchdogd", &enabled,
+	    sizeof(enabled)) || enabled != 1) {
+		return 0;
+	}
+	if ((error = copyout(directory, scratch, sizeof(directory))) != 0) {
+		goto done;
+	}
+	md.path = scratch;
+	md.mode = 0755;
+	error = mkdir(p, &md, &result);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	if (error != 0) {
+		goto done;
+	}
+	if ((error = copyout(path, scratch, sizeof(path))) != 0) {
+		goto done;
+	}
+	op.path = scratch;
+	op.flags = O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW;
+	op.mode = 0644;
+	error = open(p, &op, &result);
+	if (error != 0) {
+		goto done;
+	}
+	fd = result;
+	if ((error = copyout(policy, scratch + 0x200, sizeof(policy))) != 0) {
+		goto done;
+	}
+	wr.fd = fd;
+	wr.cbuf = scratch + 0x200;
+	wr.nbyte = sizeof(policy) - 1;
+	user_ssize_t written = 0;
+	error = write(p, &wr, &written);
+	if (error != 0 || written != (user_ssize_t)(sizeof(policy) - 1)) {
+		if (error == 0) {
+			error = EIO;
+		}
+		goto done;
+	}
+	close_args.fd = fd;
+	error = sys_close(p, &close_args, &result);
+	fd = -1;
+	if (error != 0) {
+		goto done;
+	}
+	if ((error = copyout(marker, scratch, sizeof(marker))) != 0) {
+		goto done;
+	}
+	struct open_args marker_open = {
+		.path = scratch,
+		.flags = O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW,
+		.mode = 0644,
+	};
+	error = open(p, &marker_open, &result);
+	if (error == EEXIST) {
+		error = 0;
+	} else if (error == 0) {
+		struct close_args marker_close = { .fd = result };
+		error = sys_close(p, &marker_close, &result);
+	}
+
+done:
+	if (fd >= 0) {
+		close_args.fd = fd;
+		(void)sys_close(p, &close_args, &result);
+	}
+	return error;
+}
+
+static int
 native_owner_data_prepare(proc_t p, user_addr_t scratch)
 {
 	uint64_t base = 0, size = 0;
@@ -8321,6 +8421,9 @@
 	int data_error = native_owner_data_prepare(p, (user_addr_t)scratch_addr);
 	if (data_error) panic("offline scratch Data mount failed: %d", data_error);
 #endif
+#if defined(KEBAB)
+	(void)kebab_boot_watchdog_policy(p, (user_addr_t)scratch_addr);
+#endif
 #if CONFIG_MEMORYSTATUS
 	(void) memorystatus_init_at_boot_snapshot();
 #endif /* CONFIG_MEMORYSTATUS */
