+# Built-in Apple OSS HFS: compile the vendored kext with its KPI header view.
+KEBAB_HFS_ROOT = $(SRCROOT)/bsd/kebab_hfs
+KEBAB_HFS_OBJS = BTree.o BTreeAllocate.o BTreeMiscOps.o BTreeNodeOps.o BTreeNodeReserve.o BTreeScanner.o BTreeTreeOps.o BTreeWrapper.o CatalogUtilities.o FileExtentMapping.o FileIDsServices.o MacOSStubs.o UnicodeWrappers.o VolumeAllocation.o hfs_attrlist.o hfs_btreeio.o hfs_catalog.o hfs_chash.o hfs_cnode.o hfs_cprotect.o hfs_endian.o hfs_extents.o hfs_fsinfo.o hfs_hotfiles.o hfs_journal.o hfs_link.o hfs_lookup.o hfs_notification.o hfs_quota.o hfs_readwrite.o hfs_resize.o hfs_search.o hfs_vfsops.o hfs_vfsutils.o hfs_vnops.o hfs_xattr.o rangelist.o hfs_encodinghint.o hfs_encodings.o kebab_hfs_iokit.o
+$(foreach o,$(KEBAB_HFS_OBJS),$(eval $(o)_CFLAGS_ADD += -include $(KEBAB_HFS_ROOT)/kebab_hfs_compat.h -I$(KEBAB_HFS_ROOT) -I$(KEBAB_HFS_ROOT)/core))
+hfs_encodings.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+hfs_encodinghint.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
