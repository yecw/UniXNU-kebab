+++ b/osfmk/arm64/kebab_early.c
@@ -152,6 +152,7 @@ kebab_mark_kept(unsigned int stage)
 	case 262:   /* cache mount returned */
 	case 270:   /* cache done stage/error */
 	case 271:   /* volume lookup requested */
+	case 289:   /* addsigs signature offset fallback */
 	case 290:   /* blob add stage failure */
 	case 291:   /* blob add entry */
 	case 293:   /* blob add result at the fcntl */
