diff --git a/osfmk/arm64/kebab_early.c b/osfmk/arm64/kebab_early.c
index 74c5f7d..3c7aaf0 100644
--- a/osfmk/arm64/kebab_early.c
+++ b/osfmk/arm64/kebab_early.c
@@ -127,6 +127,41 @@ kebab_early_putc(char c)
 	early_col++;
 }
 
+/* Bring-up probes that have served their purpose stay quiet: the panel is 60
+ * rows and a flood of confirmed markers pushes the new evidence off the screen.
+ * Marks are emitted from the first instructions of the kernel, before the boot
+ * arguments are parsed, so this switch must not call the boot-arg parser; set
+ * KEBAB_PROBE_VERBOSE to 1 here to get every marker back. */
+#define KEBAB_PROBE_VERBOSE 0
+
+static bool kebab_mark_suppressed;
+
+static bool
+kebab_probe_verbose(void)
+{
+	return KEBAB_PROBE_VERBOSE != 0;
+}
+
+static bool
+kebab_mark_kept(unsigned int stage)
+{
+	switch (stage) {
+	case 243:   /* root not sealed, continuing */
+	case 258:   /* panic text */
+	case 260:   /* volume lookup matched */
+	case 262:   /* cache mount returned */
+	case 270:   /* cache done stage/error */
+	case 271:   /* volume lookup requested */
+	case 295:   /* fcntl addsigs enter */
+	case 296:   /* fcntl addsigs result */
+	case 297:   /* owner-verified window */
+	case 299:   /* root verified query */
+		return true;
+	default:
+		return false;
+	}
+}
+
 void
 kebab_early_mark(unsigned int stage, const char *label)
 {
@@ -135,6 +170,11 @@ kebab_early_mark(unsigned int stage, const char *label)
 	if ((stage == 50) || (stage == 51)) {
 		return;
 	}
+	if (!kebab_probe_verbose() && !kebab_mark_kept(stage)) {
+		kebab_mark_suppressed = true;
+		return;
+	}
+	kebab_mark_suppressed = false;
 	char number[4];
 	unsigned int n = 0;
 
@@ -166,6 +206,9 @@ void
 kebab_early_hex(uint64_t value)
 {
 	char digits[19];
+	if (kebab_mark_suppressed) {
+		return;
+	}
 	int i;
 
 	digits[0] = '0';
