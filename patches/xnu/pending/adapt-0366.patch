+static void
+kebab_boot_memory_capture(const boot_args *args)
+{
+	kebab_memory_handoff h;
+	kebab_primary_base = args->physBase;
+	kebab_primary_size = args->memSize;
+
+	if (((uintptr_t)args & PAGE_MASK) != 0 || sizeof(*args) > KBM_OFFSET) {
+		kebab_boot_memory_status = 1;
+		return;
+	}
+	__builtin_memcpy(&h, (const char *)args + KBM_OFFSET, sizeof(h));
+	if (!kebab_memory_handoff_valid(&h, args->physBase, args->topOfKernelData) ||
+	    args->topOfKernelData < args->physBase ||
+	    args->topOfKernelData - args->physBase > args->memSize ||
+	    args->virtBase > UINT64_MAX - (h.physical - args->physBase)) {
+		kebab_boot_memory_status = 2;
+		return;
+	}
+	__builtin_memcpy(kebab_boot_memory,
+	    (const void *)(args->virtBase + (h.physical - args->physBase)), h.bytes);
+	kebab_boot_memory_count = h.count;
+	if (h.owned_count) {
+		__builtin_memcpy(kebab_owned_memory,
+		    (const void *)(args->virtBase + h.owned_physical - args->physBase), h.owned_bytes);
+	}
+	unsigned long long total = 0;
+	if (!kebab_owned_records_valid(&h, kebab_boot_memory, kebab_owned_memory,
+	    args->physBase, args->memSize, &total) ||
+	    args->memSizeActual != args->memSize + total) {
+		panic("KEBAB XRAM: invalid loader-owned memory records");
+	}
+	kebab_owned_memory_count = h.owned_count;
+	kebab_owned_memory_bytes = total;
 
+	kebab_boot_memory_status = 3;
+}
+#endif /* KEBAB */
