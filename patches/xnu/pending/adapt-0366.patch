+
+/* Lowest PA covered by the pmap tables: the primary bank or a lower owned bank. */
+unsigned long long
+kebab_memory_metadata_base(void)
+{
+	unsigned long long first = kebab_primary_base;
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		if (kebab_owned_memory[i].physical < first) {
+			first = kebab_owned_memory[i].physical;
+		}
+	}
+	return first;
+}
+
+int
+kebab_extra_memory_bank(unsigned int i, unsigned long long *pa, unsigned long long *n)
+{
+	if (i >= kebab_owned_memory_count) {
+		return 0;
+	}
+	*pa = kebab_owned_memory[i].physical;
+	*n = kebab_owned_memory[i].bytes;
+	return 1;
+}
+
+int
+kebab_memory_contains(unsigned long long pa, unsigned long long n)
+{
+	if (!n || pa > ~0ULL - n) {
+		return 0;
+	}
+	if (pa >= kebab_primary_base && pa - kebab_primary_base <= kebab_primary_size &&
+	    n <= kebab_primary_size - (pa - kebab_primary_base)) {
+		return 1;
+	}
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		if (pa >= d->physical && pa - d->physical <= d->bytes && n <= d->bytes - (pa - d->physical)) {
+			return 1;
+		}
+	}
+	return 0;
 }
 
+int
+kebab_memory_intersects(unsigned long long pa, unsigned long long n)
+{
+	if (!n || pa > ~0ULL - n) {
+		return 0;
+	}
+	if (pa < kebab_primary_base + kebab_primary_size && kebab_primary_base < pa + n) {
+		return 1;
+	}
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		if (pa < d->physical + d->bytes && d->physical < pa + n) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* Called from arm_vm_prot_finalize(), after pmap and the scheduler exist and
+ * before the VM page arrays are built. Explicit PFNs live outside vm_pages;
+ * its existing contiguous primary-bank layout remains unchanged. */
+void
+kebab_extra_memory_admit(void)
+{
+	if (kebab_admitted_bytes) {
+		panic("KEBAB XRAM: duplicate page admission");
+	}
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		/* Destructive test only while every page is exclusively loader-owned.
+		 * Write every 64-bit word in every bank before verifying any bank, so
+		 * cross-bank address aliases cannot hide behind sequential admission. */
+		for (unsigned long long off = 0; off < d->bytes; off += PAGE_SIZE) {
+			volatile uint64_t *p = (volatile uint64_t *)phystokv(d->physical + off);
+			for (unsigned int j = 0; j < PAGE_SIZE / 8; j++) {
+				p[j] = (d->physical + off + j * 8) ^ 0x951af742608ed3bcULL;
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		for (unsigned long long off = 0; off < d->bytes; off += PAGE_SIZE) {
+			volatile uint64_t *p = (volatile uint64_t *)phystokv(d->physical + off);
+			if (ml_static_vtop((vm_offset_t)p) != d->physical + off) {
+				panic("KEBAB XRAM: page/address test failed at 0x%llx", d->physical + off);
+			}
+			for (unsigned int j = 0; j < PAGE_SIZE / 8; j++) {
+				uint64_t expected = (d->physical + off + j * 8) ^ 0x951af742608ed3bcULL;
+				if (p[j] != expected) {
+					panic("KEBAB XRAM: RAM test failed at 0x%llx", d->physical + off + j * 8);
+				}
+				p[j] = 0;
+			}
+		}
+		kebab_tested_bytes += d->bytes;
+	}
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		vm_page_create((ppnum_t)(d->physical >> PAGE_SHIFT),
+		    (ppnum_t)((d->physical + d->bytes) >> PAGE_SHIFT));
+		kebab_admitted_bytes += d->bytes;
+	}
+	kprintf("KEBAB XRAM: admitted=%llu tested=%llu banks=%u free_pages=%u page_bytes=%u\n",
+	    kebab_admitted_bytes, kebab_tested_bytes, kebab_owned_memory_count,
+	    vm_page_free_count, (unsigned)PAGE_SIZE);
+}
+
+/* Normal-context diagnostic entry; no allocator or hardware side effects. */
+void
+kebab_boot_memory_dump(void)
+{
+	kprintf("KEBAB MEMMAP begin status=%u count=%u primary=0x%llx bytes=0x%llx measurement_only=0\n",
+	    kebab_boot_memory_status, kebab_boot_memory_count,
+	    kebab_primary_base, kebab_primary_size);
+	for (unsigned int i = 0; i < kebab_boot_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_boot_memory[i];
+		kprintf("KEBAB MEMMAP %u type=%u start=0x%llx bytes=0x%llx attr=0x%llx\n",
+		    i, d->type, d->physical, d->bytes, d->attributes);
+	}
+	kprintf("KEBAB MEMMAP end\n");
+	kprintf("KEBAB XRAM: owned=%llu admitted=%llu tested=%llu banks=%u metadata_base=0x%llx free_pages=%u\n",
+	    kebab_owned_memory_bytes, kebab_admitted_bytes, kebab_tested_bytes,
+	    kebab_owned_memory_count, kebab_memory_metadata_base(), vm_page_free_count);
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		kprintf("KEBAB XRAM bank=%u start=0x%llx bytes=0x%llx\n",
+		    i, kebab_owned_memory[i].physical, kebab_owned_memory[i].bytes);
+	}
+}
