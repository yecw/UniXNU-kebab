+#ifndef KEBAB_BOOT_MEMORY_H
+#define KEBAB_BOOT_MEMORY_H
+
+#include <mach/vm_param.h>      /* PAGE_SIZE/PAGE_MASK: this kernel runs 4 KiB pages */
+
+/* Diagnostic handoff in the loader-owned boot-argument page padding.
+ * The official Darwin22 boot_args structure and primary RAM stay unchanged.
+ * Version 2 explicitly lists pages successfully claimed by AllocatePages;
+ * the original EFI map alone never grants RAM ownership to XNU.
+ *
+ * Our loader's boot_args is 0x480 bytes (DarwinBoot BootArgs.h), so the
+ * handoff cannot sit at 0x300: that offset is inside CommandLine. The
+ * trampoline must place it at 0x480 and keep the whole table inside the
+ * 4 KiB boot-argument page (0x480 + 32 * KBM_MAX_RECORDS < 0x1000).
+ */
+#define KBM_MAGIC 0x3150414d4d42454bULL /* KEBMMAP1 */
+#define KBM_OFFSET 0x480
+#define KBM_MAX_RECORDS 512
+#define KBM_MAX_BANKS 16
+typedef struct {
+	unsigned long long magic;
+	unsigned int version;
+	unsigned int count;
+	unsigned long long physical;
+	unsigned long long bytes;
+	unsigned int owned_count;
+	unsigned int flags;
+	unsigned long long owned_physical;
+	unsigned long long owned_bytes;
+} kebab_memory_handoff;
+typedef struct {
+	unsigned long long physical;
+	unsigned long long bytes;
+	unsigned long long attributes;
+	unsigned int type;
+	unsigned int reserved;
+} kebab_memory_record;
+typedef char kbm_header_size[(sizeof(kebab_memory_handoff) == 56) ? 1 : -1];
+typedef char kbm_record_size[(sizeof(kebab_memory_record) == 32) ? 1 : -1];
+/* Keep all arithmetic bounded before converting a physical pointer to KVA. */
+static inline int
+kebab_memory_handoff_valid(const kebab_memory_handoff *h,
+    unsigned long long base, unsigned long long used_end)
+{
+	if (h->magic != KBM_MAGIC || h->version != 2 || !h->count ||
+	    h->count > KBM_MAX_RECORDS || h->bytes != h->count * sizeof(kebab_memory_record) ||
+	    (h->physical & PAGE_MASK) || used_end < base ||
+	    h->physical < base || h->physical > used_end ||
+	    h->bytes > used_end - h->physical) {
+		return 0;
+	}
+	if (h->owned_count > KBM_MAX_BANKS || h->flags != 0 ||
+	    h->owned_bytes != h->owned_count * sizeof(kebab_memory_record)) {
+		return 0;
+	}
+	if (h->owned_count && ((h->owned_physical & PAGE_MASK) ||
+	    h->owned_physical < base || h->owned_physical > used_end ||
+	    h->owned_bytes > used_end - h->owned_physical)) {
+		return 0;
+	}
+	return 1;
+}
+/* Validate every owned page against a WB-capable conventional descriptor,
+ * excluding the primary bank, firmware/runtime carveouts and duplicates. */
+static inline int
+kebab_owned_records_valid(const kebab_memory_handoff *h,
+    const kebab_memory_record *map, const kebab_memory_record *owned,
+    unsigned long long primary, unsigned long long primary_bytes,
+    unsigned long long *total)
+{
+	unsigned long long sum = 0;
+	if (!primary_bytes || primary > ~0ULL - primary_bytes) {
+		return 0;
+	}
+	for (unsigned int i = 0; i < h->owned_count; i++) {
+		unsigned long long pa = owned[i].physical, n = owned[i].bytes;
+		int found = 0;
+		if (!n || (pa & PAGE_MASK) || (n & PAGE_MASK) || pa > ~0ULL - n ||
+		    pa + n > primary || owned[i].type != 2 || owned[i].reserved) {
+			return 0;
+		}
+		for (unsigned int j = 0; j < h->count; j++) {
+			const kebab_memory_record *d = &map[j];
+			if (d->type == 7 && (d->attributes & 8) && !(d->attributes >> 63) &&
+			    d->physical <= pa && d->bytes <= ~0ULL - d->physical &&
+			    pa - d->physical <= d->bytes && n <= d->bytes - (pa - d->physical)) {
+				found = 1;
+			}
+		}
+		if (!found || n > 0x100000000ULL - sum) {
+			return 0;
+		}
+		for (unsigned int j = 0; j < i; j++) {
+			if (pa < owned[j].physical + owned[j].bytes && owned[j].physical < pa + n) {
+				return 0;
+			}
+		}
+		sum += n;
+	}
+	*total = sum;
+	return 1;
+}
+/* xram is an explicit development ladder, in MiB. 4096 means all eligible
+ * lower conventional ranges, capped at 4 GiB, not a promise of 4 GiB available. */
+static inline int
+kebab_extra_request(const char *line, unsigned long long *bytes)
+{
+	unsigned int seen = 0;
+	*bytes = 0;
+	while (*line) {
+		while (*line == ' ') {
+			line++;
+		}
+		const char *p = line;
+		while (*line && *line != ' ') {
+			line++;
+		}
+		if (line - p < 5 || p[0] != 'x' || p[1] != 'r' || p[2] != 'a' || p[3] != 'm' || p[4] != '=') {
+			continue;
+		}
+		unsigned long long n = 0;
+		if (seen++ || line - p == 5) {
+			return 0;
+		}
+		for (p += 5; p < line; p++) {
+			if (*p < '0' || *p > '9' || n > 4096) {
+				return 0;
+			}
+			n = n * 10 + (*p - '0');
+		}
+		if (n > 4096 || n % 16) {
+			return 0;
+		}
+		*bytes = n * 0x100000ULL;
+	}
+	return 1;
+}
+#endif
