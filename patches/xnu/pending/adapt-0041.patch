--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -329,14 +329,23 @@
 CFLAGS_X86_64H = $(CFLAGS_X86_64)
 
 LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+# kebab: the 4 KiB kernel uses ARM_4K_TT_L2_SIZE (2 MiB) bootstrap blocks.
+# 0xfffffff007004000 keeps the reserved first-page offset (0x4000) inside a
+# block, which is what the KVA block mapping needs; the 16 MiB shift in the
+# 16 KiB reference only applies to the 32 MiB ARM_16K_TT_L2_SIZE layout.
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
 
 # Use ARM_LARGE_MEMORY config for all MacOSX targets.
 ifneq ($(filter $(PLATFORM),MacOSX),)
 LARGE_MEMORY_DEFINE=-DARM_LARGE_MEMORY=1
-ARM64_PLKSEG_ADDR  =0xfffffe0004004000
-ARM64_LINK_ADDR    =0xfffffe0007004000
+# kebab: the 16 KiB reference layout uses 32 MiB ARM_16K_TT_L2_SIZE blocks.
+# The old 0xfffffe0007004000 left bit 24 set, so the KVA alias resolved
+# 16 MiB past the image; move both segments down one 16 MiB region, keeping
+# the 48 MiB __PRELINK_TEXT range.  The default branch above is already
+# consistent for the 4 KiB/2 MiB block size.
+ARM64_PLKSEG_ADDR  =0xfffffe0003004000
+ARM64_LINK_ADDR    =0xfffffe0006004000
 endif
 
 
--- a/osfmk/arm64/loose_ends.c
+++ b/osfmk/arm64/loose_ends.c
@@ -43,6 +43,7 @@
 #include <arm/cpu_data.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/caches_internal.h>
+#include <arm64/kebab_early.h>
 
 #include <vm/vm_kern.h>
 #include <vm/vm_map.h>
@@ -54,6 +55,19 @@
 
 #include <libkern/section_keywords.h>
 #include <libkern/OSDebug.h>
+
+#if defined(KEBAB) && defined(__arm64__)
+/*
+ * kebab: start.s maps the kernel with one ARM_TT_L2_SIZE block per L2 entry.
+ * DarwinBoot places the 4 KiB image at a 2 MiB-aligned run plus the low
+ * offset of the first segment, so the link address has to keep the reserved
+ * first-page offset (0x4000) inside an L2 block.  That block is
+ * ARM_4K_TT_L2_SIZE (2 MiB); a 16 KiB kernel selects the 32 MiB
+ * ARM_16K_TT_L2_OFFMASK instead and needs the reference patch's 16 MiB shift.
+ */
+_Static_assert((VM_KERNEL_LINK_ADDRESS & ARM_TT_L2_OFFMASK) == 0x4000,
+    "KEBAB: VM_KERNEL_LINK_ADDRESS lost the bootstrap L2 block offset");
+#endif
 
 #define INT_SIZE        (BYTE_SIZE * sizeof (int))
 
