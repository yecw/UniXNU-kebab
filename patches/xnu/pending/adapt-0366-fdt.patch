+static int
+kebab_owned_memory_overlaps(unsigned long long base, unsigned long long bytes)
+{
+	for (unsigned int i = 0; i < kebab_owned_memory_count; i++) {
+		const kebab_memory_record *d = &kebab_owned_memory[i];
+		if (base < d->physical + d->bytes && d->physical < base + bytes) {
+			return 1;
+		}
+	}
+	return 0;
