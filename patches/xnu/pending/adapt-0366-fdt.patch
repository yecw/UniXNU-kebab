+static void
+kebab_skip_record(unsigned long long base, unsigned long long bytes, unsigned int reason)
+{
+	if (reason == KBM_SKIP_TOO_MANY) {
+		kebab_boot_memory_truncated++;
+	}
+	if (kebab_boot_memory_skipped_count < KBM_MAX_SLOTS) {
+		kebab_memory_skipped_record *s =
+		    &kebab_boot_memory_skipped[kebab_boot_memory_skipped_count++];
+		s->physical = base;
+		s->bytes = bytes;
+		s->reason = reason;
+	}
+}
+
+static void
+kebab_boot_memory_capture(const boot_args *args)
+{
+	DTEntry chosen = NULL;
+	unsigned int size = 0;
+	const void *prop = NULL;
+	const char *records;
+	unsigned int slots;
+	unsigned long long total = 0;
+
+	kebab_primary_base = args->physBase;
+	/* arm_vm_init() derives avail_end (and therefore vm_last_phys and the pmap
+	 * page-array size) from the page-truncated primary size, so containment
+	 * must use the same bound: the loader may report a byte count whose last
+	 * page is only partly owned by the primary window. */
+	kebab_primary_size = args->memSize & ~(unsigned long long)PAGE_MASK;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess) {
+		kebab_boot_memory_status = 1;
+		return;
+	}
+	if (SecureDTGetProperty(chosen, KBM_FDT_PROPERTY, &prop, &size) != kSuccess ||
+	    prop == NULL || size < KBM_RECORD_SIZE || (size % KBM_RECORD_SIZE) != 0) {
+		kebab_boot_memory_status = 2;
+		return;
+	}
+	slots = size / KBM_RECORD_SIZE;
+	if (slots > KBM_MAX_SLOTS) {
+		slots = KBM_MAX_SLOTS;
+	}
+	records = prop;
+	for (unsigned int i = 0; i < slots; i++) {
+		const char *slot = records + i * KBM_RECORD_SIZE;
+		unsigned long long base, bytes;
+		unsigned int reason = 0;
+
+		/* The loader writes little-endian records into a fixed, zero-filled
+		 * buffer, so a bounded memcpy both reads unaligned slots safely and
+		 * keeps the byte order explicit. */
+		__builtin_memcpy(&base, slot, sizeof(base));
+		__builtin_memcpy(&bytes, slot + sizeof(base), sizeof(bytes));
+		if (!base && !bytes) {
+			continue;               /* unused slot */
+		}
+		if (!bytes) {
+			reason = KBM_SKIP_EMPTY_SIZE;
+		} else if ((base & PAGE_MASK) || (bytes & PAGE_MASK)) {
+			reason = KBM_SKIP_MISALIGNED;
+		} else if (base > ~0ULL - bytes) {
+			reason = KBM_SKIP_OVERFLOW;
+		} else if (base + bytes > kebab_primary_base) {
+			/* 0366's design constraint: the bank has to sit entirely below
+			 * the primary kernel-managed window, so the pmap tables and the
+			 * physmap index math stay anchored at gPhysBase. */
+			reason = KBM_SKIP_ABOVE_PRIMARY;
+		} else if (kebab_owned_memory_count >= KBM_MAX_BANKS) {
+			reason = KBM_SKIP_TOO_MANY;
+		} else if (kebab_owned_memory_overlaps(base, bytes)) {
+			reason = KBM_SKIP_OVERLAP;
+		}
+		if (reason) {
+			kebab_skip_record(base, bytes, reason);
+			continue;
+		}
+		kebab_owned_memory[kebab_owned_memory_count].physical = base;
+		kebab_owned_memory[kebab_owned_memory_count].bytes = bytes;
+		kebab_owned_memory_count++;
+		total += bytes;
+	}
+	kebab_owned_memory_bytes = total;
+
+	kebab_boot_memory_status = 3;
+}
+#endif /* KEBAB */
