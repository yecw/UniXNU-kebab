+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef KEBAB_BOOT_MEMORY_H
+#define KEBAB_BOOT_MEMORY_H
+
+#include <mach/vm_param.h>      /* PAGE_SIZE/PAGE_MASK: this kernel runs 4 KiB pages */
+
+/* The loader publishes the RAM it owns outside the primary kernel-managed bank
+ * as a device-tree property under /chosen. DarwinBoot pre-creates the property
+ * zero-filled (16 * slots bytes, 1..64 slots) and fills one record per range,
+ * little endian:
+ *
+ *	<u64 base><u64 size>		(KBM_RECORD_SIZE bytes)
+ *
+ * The loader fills slots from the front; an all-zero record is an unused slot.
+ * XNU reads the property once in arm_init(), after PE_init_platform(FALSE,
+ * args) has run SecureDTInit() and after the kernel page size has been
+ * selected, and adopts at most KBM_MAX_BANKS ranges because the physmap
+ * aperture table is sized for that. Nothing here infers ownership from the EFI
+ * memory map: only a record the loader actually wrote grants XNU ownership of
+ * a range.
+ *
+ * /chosen/darwinboot-memory-outside-kept is a parallel <u64 base><u64 size>
+ * array naming ranges the firmware calls free but that the kernel must leave
+ * alone (memory a board driver uses at a fixed address). This kernel does not
+ * read it: the loader must simply not put those ranges in the outside table,
+ * and because only listed ranges are ever touched, they stay reserved.
+ */
+#define KBM_FDT_PROPERTY "darwinboot-memory-outside"
+#define KBM_FDT_KEPT_PROPERTY "darwinboot-memory-outside-kept"
+#define KBM_MAX_BANKS 16
+#define KBM_MAX_SLOTS 64
+#define KBM_RECORD_SIZE 16
+
+typedef struct {
+	unsigned long long physical;
+	unsigned long long bytes;
+} kebab_memory_record;
+typedef char kbm_record_size[(sizeof(kebab_memory_record) == KBM_RECORD_SIZE) ? 1 : -1];
+
+/* Why one loader record was not adopted; kept for the early kprintf dump. */
+typedef struct {
+	unsigned long long physical;
+	unsigned long long bytes;
+	unsigned int reason;
+} kebab_memory_skipped_record;
+
+enum {
+	KBM_SKIP_EMPTY_SIZE = 1,        /* size == 0 with a nonzero base */
+	KBM_SKIP_MISALIGNED,            /* not whole PAGE_SIZE pages */
+	KBM_SKIP_OVERFLOW,              /* base + size wraps around */
+	KBM_SKIP_ABOVE_PRIMARY,         /* not entirely below gPhysBase */
+	KBM_SKIP_OVERLAP,               /* overlaps an already adopted bank */
+	KBM_SKIP_TOO_MANY,              /* more than KBM_MAX_BANKS usable records */
+};
+
+/* xram is an explicit development ladder, in MiB. 4096 means all eligible
+ * lower conventional ranges, capped at 4 GiB, not a promise of 4 GiB available. */
+static inline int
+kebab_extra_request(const char *line, unsigned long long *bytes)
+{
+	unsigned int seen = 0;
+	*bytes = 0;
+	while (*line) {
+		while (*line == ' ') {
+			line++;
+		}
+		const char *p = line;
+		while (*line && *line != ' ') {
+			line++;
+		}
+		if (line - p < 5 || p[0] != 'x' || p[1] != 'r' || p[2] != 'a' || p[3] != 'm' || p[4] != '=') {
+			continue;
+		}
+		unsigned long long n = 0;
+		if (seen++ || line - p == 5) {
+			return 0;
+		}
+		for (p += 5; p < line; p++) {
+			if (*p < '0' || *p > '9' || n > 4096) {
+				return 0;
+			}
+			n = n * 10 + (*p - '0');
+		}
+		if (n > 4096 || n % 16) {
+			return 0;
+		}
+		*bytes = n * 0x100000ULL;
+	}
+	return 1;
+}
+#endif
