diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index c705c6a..b6f7b0c 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7193,6 +7193,7 @@ native_owner_cache_prepare(proc_t p, user_addr_t scratch, user_addr_t *envp)
 		extern void kebab_early_mark(unsigned, const char *);
 		extern void kebab_early_hex(unsigned long long);
