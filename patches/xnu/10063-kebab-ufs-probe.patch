+/*
+ * The UFS host issues DMA through SID 0x4E0 / 0x0E0. ABL leaves those streams
+ * translated through a context bank, and the transfer list the driver hands the
+ * controller then describes physical addresses the SMMU will not accept: the
+ * controller stalls on the first fetch and every later register read hangs the
+ * bus. Make the two UFS SIDs bypass translation first, exactly as the firmware
+ * does on boards that keep a UFS driver (SmmuBypassDxe): only entries whose SMR
+ * has a zero mask are touched, so a wildcard shared with another device is left
+ * alone.
+ */
+#define SMMU_BASE        0x15000000u
+#define SMMU_GROUPS      0x20
+#define SMMU_SMR(n)      (0x800 + (n) * 4)
+#define SMMU_S2CR(n)     (0xC00 + (n) * 4)
+#define SMR_VALID        (1u << 31)
+#define S2CR_TYPE_BYPASS 1u
+
+static int
+ufs_smmu_scan(uint32_t base, int apply)
+{
+	vm_offset_t smmu = ml_io_map((vm_offset_t)base, 0x10000);
+	{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+	  kebab_early_mark(206, "ufs: SMMU mapped"); kebab_early_hex(base); }
+	if (!smmu) {
+		return ENOMEM;
+	}
+	uint32_t groups = *(volatile uint32_t *)(smmu + SMMU_GROUPS) & 0x3F;
+	{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+	  kebab_early_mark(207, "ufs: SMMU groups read"); kebab_early_hex(groups); }
+	/* GROUPS is not the SMR count: SMMU-500 reports groups of two SMRs, so the
+	 * UFS streams can sit past the first GROUPS slots. Scan the architectural
+	 * maximum and look for the exact-match entries. */
+	unsigned slots = 64;
+	for (unsigned s = 0; s < slots; s++) {
+		uint32_t smr = *(volatile uint32_t *)(smmu + SMMU_SMR(s));
+		uint32_t sid = smr & 0xFFFF, mask = (smr >> 16) & 0xFFFF;
+		if (smr & SMR_VALID) {
+			{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+			  kebab_early_mark(208, "ufs: SMMU SMR"); kebab_early_hex(sid); kebab_early_hex(mask); }
+		}
+		if ((smr & SMR_VALID) == 0 || mask != 0) {
+			continue;
+		}
+		if (sid != 0x04E0 && sid != 0x00E0) {
+			continue;
+		}
+		uint32_t s2cr = *(volatile uint32_t *)(smmu + SMMU_S2CR(s));
+		s2cr = (s2cr & ~(3u << 16)) | (S2CR_TYPE_BYPASS << 16);
+		*(volatile uint32_t *)(smmu + SMMU_S2CR(s)) = s2cr;
+		(void)*(volatile uint32_t *)(smmu + SMMU_S2CR(s) + 4);
+		printf("KEBAB UFS: SMMU SID 0x%03x -> bypass (slot %u)\n", sid, s);
+		{ extern void kebab_early_mark(unsigned, const char *); kebab_early_mark(198, "ufs: SMMU SID bypassed"); }
+	}
+	return 0;
+}
+
+static int
+ufs_smmu_bypass(void)
+{
+	/* Only the apps SMMU is powered at this point: reading the second instance
+	 * (0x15400000) hangs the bus, and its 64 SMR slots carry no UFS stream
+	 * either, so UFS DMA is untranslated from the SMMU's point of view. */
+	(void)ufs_smmu_scan(0x15000000u, 1);
+	return 0;
+}
