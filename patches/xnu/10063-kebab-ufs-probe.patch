+/*
+ * The flashed root image is not a filesystem: it starts with the SHNGROOT
+ * manifest that lists the IPSW's OS and SystemOS images as windows
+ * (unixnu userdata writes it).  Read the manifest from the partition's first
+ * 4 KiB block and narrow the BSD disk to the "OS" window, so APFS sees the
+ * OS image's own APFS container instead of the manifest.
+ */
+#define MANIFEST_HEADER 24
+#define MANIFEST_ENTRY  128
+
+static uint32_t
+ufs_le32(const uint8_t *at)
+{
+	return (uint32_t)at[0] | ((uint32_t)at[1] << 8) | ((uint32_t)at[2] << 16) | ((uint32_t)at[3] << 24);
+}
+
+static uint64_t
+ufs_le64(const uint8_t *at)
+{
+	return (uint64_t)ufs_le32(at) | ((uint64_t)ufs_le32(at + 4) << 32);
+}
+
+static int
+ufs_apply_manifest(void)
+{
+	uint8_t *block = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+	uint64_t offset = 0, size = 0;
+	uint32_t version, count;
+	int error;
+
+	error = ufs_read_blocks(su.first_block, 1);
+	if (error) {
+		return 0;                       /* keep the raw partition */
+	}
+	if (memcmp(block, "SHNGROOT", 8) != 0) {
+		printf("KEBAB UFS: no SHNGROOT manifest, using the whole partition\n");
+		return 0;
+	}
+	version = ufs_le32(block + 8);
+	count   = ufs_le32(block + 12);
+	{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+	  kebab_early_mark(217, "ufs: SHNGROOT header"); kebab_early_hex(version); kebab_early_hex(count); }
+	printf("KEBAB UFS: SHNGROOT v%u windows=%u\n", version, count);
+	if (version < 1 || version > 2 || count == 0 || count > 8 ||
+	    MANIFEST_HEADER + (uint64_t)count * MANIFEST_ENTRY > UFS_BLOCK) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *entry = block + MANIFEST_HEADER + (uint64_t)i * MANIFEST_ENTRY;
+		if (strncmp((const char *)entry, "OS", sizeof("OS")) == 0 && entry[2] == 0) {
+			offset = ufs_le64(entry + 32);
+			size   = ufs_le64(entry + 40);
+		}
+	}
+	if (size == 0) {
+		printf("KEBAB UFS: manifest has no OS window\n");
+		return ENXIO;
+	}
+	/* The manifest aligns windows to 1 MiB but their sizes need not be a whole
+	 * number of 4 KiB blocks (the OS window is 6077580800 bytes); what must be
+	 * block aligned is the start and the end of the window. */
+	uint64_t rounded = (size + UFS_BLOCK - 1) & ~(uint64_t)(UFS_BLOCK - 1);
+
+	if (offset > part_bytes || rounded > part_bytes - offset ||
+	    (offset % UFS_BLOCK)) {
+		printf("KEBAB UFS: OS window outside the partition (off 0x%llx size 0x%llx)\n",
+		    offset, size);
+		{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+		  kebab_early_mark(215, "ufs: OS window rejected"); kebab_early_hex(offset); kebab_early_hex(size); }
+		return EINVAL;
+	}
+	su.window_off   = offset;
+	su.window_bytes = rounded;
+	/* The window is itself a disk image with a GPT; the APFS partition sits at a
+	 * 512-byte (not 4 KiB) aligned offset inside it, so the BSD disk is narrowed
+	 * to that partition by byte offset. */
+	{
+		uint8_t *gpt = (uint8_t *)(su.dma + DMA_BOUNCE);
+		if (!ufs_read_blocks(su.first_block + offset / UFS_BLOCK, 1) &&
+		    memcmp(gpt + 0x200, "EFI PART", 8) == 0) {
+			uint64_t entries_lba = ufs_le64(gpt + 0x200 + 72);
+			uint32_t count2      = ufs_le32(gpt + 0x200 + 80);
+			uint32_t esz         = ufs_le32(gpt + 0x200 + 84);
+			if (entries_lba * 512 + (uint64_t)count2 * esz <= UFS_BLOCK) {
+				for (uint32_t i = 0; i < count2; i++) {
+					const uint8_t *e = gpt + entries_lba * 512 + (uint64_t)i * esz;
+					/* APFS container partition type, on-disk byte order */
+					static const uint8_t apfs[16] = {
+						0xef, 0x57, 0x34, 0x7c, 0x00, 0x00, 0xaa, 0x11,
+						0xaa, 0x11, 0x00, 0x30, 0x65, 0x43, 0xec, 0xac
+					};
+					if (memcmp(e, apfs, sizeof(apfs)) != 0) {
+						continue;
+					}
+					uint64_t start = ufs_le64(e + 32), last = ufs_le64(e + 40);
+					if (last >= start && (last - start + 1) * 512 <= rounded - (start * 512)) {
+						su.window_off   = offset + start * 512;
+						su.window_bytes = (last - start + 1) * 512;
+					}
+					break;
+				}
+			}
+		}
+	}
+	{ extern void kebab_early_mark(unsigned, const char *); extern void kebab_early_hex(unsigned long long);
+	  kebab_early_mark(214, "ufs: OS window"); kebab_early_hex(offset); kebab_early_hex(size); }
+	printf("KEBAB UFS: OS window off 0x%llx size 0x%llx, BSD disk on the OS image\n",
+	    offset, size);
+	return 0;
+}
