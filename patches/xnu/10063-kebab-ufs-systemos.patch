@@ -932,8 +938,12 @@
 			kebab_early_mark(219, "ufs: window head");
 			kebab_early_hex(magic);
 		}
 	}
+	if (su.systemos_bytes != 0) {
+		printf("KEBAB UFS: SystemOS window off 0x%llx size 0x%llx\n",
+		    su.systemos_off, su.systemos_bytes);
+	}
 	printf("KEBAB UFS: OS window off 0x%llx size 0x%llx, BSD disk on the OS image\n",
 	    offset, size);
 	return 0;
 }
