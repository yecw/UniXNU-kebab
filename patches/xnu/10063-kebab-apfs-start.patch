+# KEBAB: start a prelinked filesystem kext by identifier
+iokit/Kernel/arm/KebabKextStart.cpp		optional iokitcpp
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -798,8 +798,21 @@
 	/* Initialize the file systems. */
 	{ extern void kebab_early_mark(unsigned, const char *); kebab_early_mark(181, "bsd_init: IOKitInitializeTime done"); }
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
+
+#if defined(KEBAB)
+	/* APFS is prelinked but never matches an IOMedia here; start it so it
+	 * registers with vfsconf before vfs_mountroot() walks the list. */
+	{
+		extern int kebab_start_kext(const char *);
+		int kext_result = kebab_start_kext("com.apple.filesystems.apfs");
+		extern void kebab_early_mark(unsigned, const char *);
+		extern void kebab_early_hex(unsigned long long);
+		kebab_early_mark(224, "bsd_init: apfs kext start");
+		kebab_early_hex((unsigned long long)(unsigned)kext_result);
+	}
+#endif
