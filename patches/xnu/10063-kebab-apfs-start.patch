diff --git a/iokit/Kernel/arm/KebabKextStart.cpp b/iokit/Kernel/arm/KebabKextStart.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/KebabKextStart.cpp
@@ -0,0 +1,30 @@
+/*
+ * KEBAB: start a prelinked filesystem kext by identifier.
+ *
+ * Prelinked kexts are only loaded, not started: a filesystem kext registers its
+ * vfs operations from its start routine, and APFS only reaches that when its
+ * IOMedia personality matches. The BSD UFS driver publishes a bdevsw instead,
+ * so nothing ever matches and vfsconf stays without apfs. Starting the kext
+ * explicitly runs that registration; it is the same call the IOKit matching
+ * path makes once a media shows up.
+ */
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSKext.h>
+#include <libkern/OSReturn.h>
+
+extern "C" int
+kebab_start_kext(const char *identifier)
+{
+	OSReturn result;
+
+	if (identifier == NULL) {
+		return -1;
+	}
+	result = OSKext::loadKextWithIdentifier(identifier,
+	    /* allowDefer */ false,
+	    /* delayAutounload */ false,
+	    /* start */ kOSKextExcludeNone,
+	    /* startMatching */ kOSKextExcludeAll);
+	IOLog("KEBAB KEXT: start %s -> 0x%x\n", identifier, (unsigned)result);
+	return (int)result;
+}
--- a/iokit/conf/files.arm64
+++ b/iokit/conf/files.arm64
@@ -7,4 +7,7 @@
 iokit/Kernel/arm/AppleARMSMP.cpp    					optional iokitcpp
 
 # tightbeamc generated implementation files
 ./Exclaves/IOService.tightbeam.c		optional iokitcpp config_exclaves
