diff --git a/bsd/kebab_hfs/AppleKeyStore/AppleKeyStoreFSServices.h b/bsd/kebab_hfs/AppleKeyStore/AppleKeyStoreFSServices.h
new file mode 100644
--- /dev/null
+++ b/bsd/kebab_hfs/AppleKeyStore/AppleKeyStoreFSServices.h
@@ -0,0 +1,49 @@
+/*
+ * Minimal stand-in for Apple's AppleKeyStore/AppleKeyStoreFSServices.h.
+ *
+ * This XNU tree does not ship the AppleKeyStore headers, but the vendored HFS
+ * sources include them when CONFIG_PROTECT is on. HFS only uses these types for
+ * its own bookkeeping: it never calls an AKS function, so a layout-compatible
+ * declaration is enough to compile and link.
+ */
+#ifndef _APPLEKEYSTORE_FSSERVICES_H_
+#define _APPLEKEYSTORE_FSSERVICES_H_
+
+#include <sys/types.h>
+#include <sys/cdefs.h>
+#include <uuid/uuid.h>
+
+#define AKS_RAW_KEY_WRAPPEDKEY  0x00000001
+
+__BEGIN_DECLS
+
+struct aks_cred_s {
+	uint64_t     inode;
+	int32_t      pid;
+	uint32_t     uid;
+	uint32_t     key_revision;
+	uuid_t       volume_uuid;
+};
+
+struct aks_wrapped_key_s {
+	uint32_t     dp_class;
+	void        *key;
+	size_t       key_len;
+};
+
+struct aks_raw_key_s {
+	uint32_t     flags;
+	uint32_t     dp_class;
+	void        *key;
+	size_t       key_len;
+	void        *iv_key;
+	size_t       iv_key_len;
+};
+
+typedef struct aks_cred_s        *aks_cred_t;
+typedef struct aks_raw_key_s     *aks_raw_key_t;
+typedef struct aks_wrapped_key_s *aks_wrapped_key_t;
+
+__END_DECLS
+
+#endif /* _APPLEKEYSTORE_FSSERVICES_H_ */
--- a/bsd/kebab_hfs/kebab_hfs_compat.h
+++ b/bsd/kebab_hfs/kebab_hfs_compat.h
@@ -30,4 +30,8 @@
 /* Built in, not a loadable kext (see kebab_hfs_iokit.c). */
 #define OSKextGetCurrentLoadTag kebab_hfs_current_load_tag
 #endif /* KEBAB */
 #endif /* KEBAB_HFS_COMPAT_H */
+
+/* hfs_attrlist.c uses this before hfs_cnode.h is pulled in. */
+struct cnode;
+int hfs_file_is_compressed(struct cnode *cp, int skiplock);
