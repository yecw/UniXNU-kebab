diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index 2656adb..90ec399 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -4829,6 +4829,36 @@ ubc_cs_blob_add(
 #endif /* CODE_SIGNING_MONITOR */
 
 #if CONFIG_MACF
+	{
+		extern void kebab_early_mark(unsigned, const char *);
+		extern void kebab_early_hex(unsigned long long);
+		static unsigned entry_marks;
+		if (entry_marks < 4) {
+			entry_marks++;
+			kebab_early_mark(291, "cs blob: macf entry");
+			kebab_early_hex((unsigned long long)size);
+			/* volume device of the vnode, to tell which mount it is */
+			{
+				extern int native_verified_block_volume_device(const char *, dev_t *,
+				    char *, size_t);
+				dev_t cache_device = 0;
+				char path[64];
+				if (native_verified_block_volume_device(
+				    "8846FE78-2910-4297-AF97-D59BB6F8FC16", &cache_device,
+				    path, sizeof(path))) {
+					kebab_early_hex((unsigned long long)(unsigned)cache_device);
+				} else {
+					kebab_early_hex(0);
+				}
+			}
+			{
+				extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+				char value[8];
+				kebab_early_hex((unsigned long long)(PE_parse_boot_argn(
+				    "kebab_skip_dsc_macf", value, sizeof(value)) ? 1 : 0));
+			}
+		}
+	}
 	unsigned int cs_flags = tmp_blob.csb_flags;
 	unsigned int signer_type = tmp_blob.csb_signer_type;
 
