diff --git a/osfmk/arm64/kebab_early.c b/osfmk/arm64/kebab_early.c
new file mode 100644
index 0000000..5fb7ed4
--- /dev/null
+++ b/osfmk/arm64/kebab_early.c
@@ -0,0 +1,126 @@
+/*
+ * KEBAB early framebuffer console, ported from GFander/KebabEarlyConsole.
+ *
+ * start.s maps the splash frame buffer (0x9C000000, 1080x2400, 4320 bytes per
+ * row, BGRA) as a V=P bootstrap block, so this console can draw from the first
+ * C instruction. No allocation, locks, ADT parsing or per-CPU state: panic()
+ * can reach it before a current thread exists. The rows are cleaned to the
+ * point of coherency after every glyph so the panel sees them at once.
+ */
+#include <arm64/kebab_early.h>
+
+#if defined(KEBAB)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#define KEBAB_EARLY_FB 0x9c000000ULL
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)KEBAB_EARLY_FB;
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2400u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+/* The console starts at text row 4 so its output clears the camera punch-hole. */
+#define EARLY_TOP_ROW 4u
+
+extern unsigned char iso_font[256 * 16];
+
+static unsigned int early_row = EARLY_TOP_ROW, early_col;
+static unsigned int early_started, early_disabled;
+
+static void
+kebab_early_clean(unsigned int row)
+{
+	uintptr_t start = (uintptr_t)(early_fb + (row * EARLY_CELL_H) * EARLY_STRIDE);
+	uintptr_t end = start + (uintptr_t)EARLY_CELL_H * EARLY_STRIDE * 4u;
+
+	start &= ~(uintptr_t)63u;
+	for (; start < end; start += 64u) {
+		__asm__ volatile("dc civac, %0" :: "r"(start) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+kebab_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = early_fb + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+	kebab_early_clean(early_row);
+}
+
+void
+kebab_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		kebab_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = EARLY_TOP_ROW + (early_row - EARLY_TOP_ROW + 1) % (EARLY_ROWS - EARLY_TOP_ROW);
+		kebab_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	kebab_early_clean(early_row);
+	early_col++;
+}
+
+void
+kebab_early_mark(unsigned int stage, const char *label)
+{
+	char number[4];
+	unsigned int n = 0;
+
+	do {
+		number[n++] = (char)('0' + stage % 10);
+		stage /= 10;
+	} while (stage != 0 && n < sizeof number);
+	while (n != 0) {
+		kebab_early_putc(number[--n]);
+	}
+	kebab_early_putc(' ');
+	kebab_early_putc(':');
+	kebab_early_putc(' ');
+	for (const char *p = label; p != 0 && *p != 0; p++) {
+		kebab_early_putc(*p);
+	}
+	kebab_early_putc('\n');
+}
+
+void
+kebab_early_disable(void)
+{
+	early_disabled = 1;
+}
+#endif /* KEBAB */
diff --git a/osfmk/arm64/kebab_early.h b/osfmk/arm64/kebab_early.h
new file mode 100644
index 0000000..415b3ee
--- /dev/null
+++ b/osfmk/arm64/kebab_early.h
@@ -0,0 +1,19 @@
+/* KEBAB early console: the panel is the only output before any driver exists. */
+#ifndef _ARM64_KEBAB_EARLY_H_
+#define _ARM64_KEBAB_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>   /* selects BCM2837.h, which defines KEBAB */
+#include <stdarg.h>
+#include <stdint.h>
+
+#if defined(KEBAB)
+void kebab_early_mark(unsigned int stage, const char *label);
+void kebab_early_putc(char c);
+void kebab_early_disable(void);
+#else
+static inline void kebab_early_mark(unsigned int stage, const char *label) { (void)stage; (void)label; }
+static inline void kebab_early_putc(char c) { (void)c; }
+static inline void kebab_early_disable(void) {}
+#endif
+
+#endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 11de723..8f06e2a 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -623,6 +623,18 @@ Lbootstrap_tables_exhausted:
 	// the early debugger rather than corrupting memory or forging a map.
 	b Lbootstrap_tables_exhausted
 Lbootstrap_tables_ready:
+#if defined(KEBAB)
+	/*
+	 * KEBAB: map the splash frame buffer (0x9C000000, 1080x2400) as a V=P
+	 * block, so osfmk/arm64/kebab_early.c can draw from the first C code on.
+	 * Six 2 MiB blocks cover the 10.4 MB the panel needs.
+	 */
+	MOV64	x0, 0x9c000000
+	MOV64	x4, 0x9c000000
+	mov	x5, #6
+	create_bootstrap_mapping x0, x4, x5, x1, x2, x6, x10, x11, x12, x13
+#endif /* KEBAB */
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
